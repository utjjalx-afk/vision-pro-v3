          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000-\\u001f]*\\S)?$",
          "type": "string"
        },
        "timing": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000-\\u001f]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "ambiguity",
        "capabilities",
        "costs",
        "liquidity",
        "mode",
        "timing"
      ],
      "type": "object"
    },
    "exit": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S(?:[^\\u0000-\\u001f]*\\S)?$",
