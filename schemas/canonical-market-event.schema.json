{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source",
    "instrument_id",
    "event_type",
    "source_ts",
    "received_ts",
    "sequence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "source": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "instrument_id": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "event_type": {
      "enum": [
        "trade",
        "quote",
        "bar"
      ]
    },
    "source_ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "received_ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "timestamp_basis": {
      "enum": [
        "exchange",
        "receipt"
      ],
      "default": "exchange"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "provider_sequence": {
      "type": "string",
      "pattern": "^\\S(?:.*\\S)?$",
      "default": "unknown"
    },
    "continuity": {
      "enum": [
        "contiguous",
        "snapshot",
        "unverified"
      ],
      "default": "unverified"
    },
    "delivery_kind": {
      "enum": [
        "live",
        "backfill"
      ],
      "default": "live"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalMarketEvent v1",
  "description": "Phase-2 exact decimal contract with source epochs and continuity provenance.",
  "oneOf": [
    {
      "properties": {
        "event_type": {
          "const": "trade"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price",
            "quantity"
          ],
          "properties": {
            "price": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "quantity": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "buyer_is_maker": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "quote"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bid",
            "ask",
            "bid_quantity",
            "ask_quantity"
          ],
          "properties": {
            "bid": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "ask": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "bid_quantity": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "ask_quantity": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "bar"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "high",
            "low",
            "close",
            "volume",
            "interval_seconds"
          ],
          "properties": {
            "open": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "high": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "low": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "close": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "volume": {
              "type": "string",
              "pattern": "^[0-9]+(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
            },
            "interval_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "open_ts": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "price_basis": {
              "enum": ["bid", "ask"]
            },
            "volume_basis": {
              "const": "price_count"
            }
          },
          "dependentRequired": {
            "price_basis": ["volume_basis"],
            "volume_basis": ["price_basis"]
          }
        }
      }
    }
  ]
}
