        "starting_cash": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "commit_sha",
        "starting_cash"
      ],
      "type": "object"
    },
