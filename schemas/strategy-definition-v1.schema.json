{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural artifact schema. Exact Decimal bounds, references and supported runtime semantics are additionally enforced by the deterministic parser/compiler. No defaults or deployment permission.",
  "properties": {
    "acceptance": {
      "additionalProperties": false,
      "properties": {
        "maximum_drawdown_fraction": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        "maximum_pbo": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        "minimum_net_pnl": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
          "type": "string"
        },
        "minimum_trades": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maximum_drawdown_fraction",
        "maximum_pbo",
        "minimum_net_pnl",
        "minimum_trades"
      ],
      "type": "object"
    },
    "entry": {
