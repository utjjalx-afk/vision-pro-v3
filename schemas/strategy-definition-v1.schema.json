            },
            "multiplier": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            "operator": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^\\S(?:[^\\u0000-\\u001f]*\\S)?$",
              "type": "string"
            },
            "right_feature": {
              "maxLength": 128,
              "minLength": 1,
