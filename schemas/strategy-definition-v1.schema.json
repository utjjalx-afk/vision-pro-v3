            "gross_exposure_fraction": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            "per_trade_fraction": {
              "maxLength": 128,
