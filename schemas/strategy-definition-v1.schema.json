        "asset_class",
        "canonical_symbol",
        "instrument",
        "required_data",
        "timeframe_seconds",
        "warmup"
      ],
      "type": "object"
    },
    "origin": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "generator_id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "STRUCTURED"
              }
            }
          },
          "then": {
            "properties": {
              "generator_id": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "generator_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
